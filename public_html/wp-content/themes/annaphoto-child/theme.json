{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "typography": {
            "customFontSize": true,
            "lineHeight": true,
            "letterSpacing": true,
            "textAlign": true,
            "textDecoration": true,
            "textTransform": true,
            "fontStyle": true,
            "fontWeight": true,
            "writingMode": true,
            "dropCap": true,
            "fontSizes": [
                { "slug": "tiny",    "size": "11px", "name": "Minuscule" },
                { "slug": "small",   "size": "13px", "name": "Petite" },
                { "slug": "normal",  "size": "17px", "name": "Normale" },
                { "slug": "medium",  "size": "20px", "name": "Moyenne" },
                { "slug": "large",   "size": "26px", "name": "Grande" },
                { "slug": "xlarge",  "size": "34px", "name": "Titre" },
                { "slug": "huge",    "size": "48px", "name": "Immense" },
                { "slug": "giant",   "size": "64px", "name": "Enorme" }
            ],
            "fontFamilies": [
                {
                    "slug":       "display",
                    "name":       "Titre elegant (Georgia italique)",
                    "fontFamily": "Georgia, 'Cormorant Garamond', 'Playfair Display', serif"
                },
                {
                    "slug":       "body",
                    "name":       "Texte lisible (Inter)",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', Roboto, sans-serif"
                },
                {
                    "slug":       "serif",
                    "name":       "Serif classique",
                    "fontFamily": "'Times New Roman', Times, serif"
                },
                {
                    "slug":       "script",
                    "name":       "Ecriture manuscrite",
                    "fontFamily": "'Brush Script MT', cursive"
                },
                {
                    "slug":       "mono",
                    "name":       "Machine a ecrire",
                    "fontFamily": "'Courier New', Courier, monospace"
                }
            ]
        },
        "color": {
            "custom": true,
            "customGradient": true,
            "customDuotone": true,
            "text": true,
            "background": true,
            "link": true,
            "palette": [
                { "slug": "rose",       "color": "#d4a5a5", "name": "Rose poudre" },
                { "slug": "mauve",      "color": "#8b6f6f", "name": "Mauve" },
                { "slug": "aubergine",  "color": "#3d2e2e", "name": "Aubergine" },
                { "slug": "cream",      "color": "#fdf5f2", "name": "Creme" },
                { "slug": "rose-pale",  "color": "#f4e0dc", "name": "Rose pale" },
                { "slug": "taupe",      "color": "#a89592", "name": "Taupe" },
                { "slug": "sauge",      "color": "#8e9976", "name": "Sauge" },
                { "slug": "noir",       "color": "#0f0f0f", "name": "Noir" },
                { "slug": "blanc",      "color": "#ffffff", "name": "Blanc" }
            ],
            "gradients": [
                {
                    "slug":     "rose-gradient",
                    "name":     "Degrade rose",
                    "gradient": "linear-gradient(135deg, #f4e0dc 0%, #d4a5a5 100%)"
                },
                {
                    "slug":     "aubergine-gradient",
                    "name":     "Degrade aubergine",
                    "gradient": "linear-gradient(135deg, #8b6f6f 0%, #3d2e2e 100%)"
                }
            ]
        },
        "spacing": {
            "padding":  true,
            "margin":   true,
            "blockGap": true,
            "units":    [ "px", "em", "rem", "%", "vw", "vh" ],
            "spacingSizes": [
                { "slug": "xs", "size": "8px",  "name": "Tres petit" },
                { "slug": "sm", "size": "16px", "name": "Petit" },
                { "slug": "md", "size": "24px", "name": "Moyen" },
                { "slug": "lg", "size": "48px", "name": "Grand" },
                { "slug": "xl", "size": "80px", "name": "Tres grand" }
            ]
        },
        "layout": {
            "contentSize": "720px",
            "wideSize":    "1080px"
        },
        "border": {
            "color":  true,
            "radius": true,
            "style":  true,
            "width":  true
        }
    }
}
